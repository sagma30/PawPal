# ── App & Server ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET="zooby-dev-secret-change-in-production-min-64-chars-long"
JWT_EXPIRES_IN=86400

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Set your actual Gemini API key here for AI pet health advisor functionality.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
